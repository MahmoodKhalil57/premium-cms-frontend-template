{
	"$schema": "./schemas/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Site seed",
		"description": "Content-as-code for this site, applied on every deploy (update-on-conflict). Root settings live here; content entries live one-per-file under seed/content/<collection>/<slug>.json."
	},
	"collections": [
		{
			"slug": "products",
			"label": "Products",
			"labelSingular": "Product",
			"hasSeo": true,
			"supports": [
				"drafts",
				"revisions",
				"search"
			],
			"urlPattern": "/products/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "price",
					"label": "Price",
					"type": "number",
					"required": true
				},
				{
					"slug": "compare_at_price",
					"label": "Compare-at price",
					"type": "number"
				},
				{
					"slug": "sku",
					"label": "SKU",
					"type": "string"
				},
				{
					"slug": "stock",
					"label": "Stock (blank = unlimited)",
					"type": "integer"
				},
				{
					"slug": "image",
					"label": "Image",
					"type": "image"
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "requires_shipping",
					"label": "Requires shipping",
					"type": "boolean",
					"defaultValue": true
				},
				{
					"slug": "featured",
					"label": "Featured",
					"type": "boolean"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "Posts",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "Search",
					"url": "/search"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/admin",
			"destination": "/_emdash/admin",
			"type": 302
		}
	],
	"widgetAreas": [
		{
			"name": "footer",
			"label": "Footer widgets",
			"description": "Rendered in the footer's widget column.",
			"widgets": [
				{
					"type": "content",
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "w0",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "w1",
									"text": "Edit this widget under Manage → Widgets, or replace it in seed/seed.json."
								}
							]
						}
					]
				}
			]
		}
	],
	"content": {}
}
