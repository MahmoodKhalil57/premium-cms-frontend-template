---
import Base from "../../layouts/Base.astro";
import Image from "../../components/Image.astro";
import { getEmDashCollection, getUsedTerms } from "../../lib/emdash";

export async function getStaticPaths() {
	const terms = await getUsedTerms("posts", "category");
	return terms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props;
const { entries } = await getEmDashCollection("posts");
const posts = entries.filter((p) => (p.data.terms.category ?? []).some((t) => t.slug === term.slug));
---

<Base title={`${term.label} posts`} description={`Posts in ${term.label}`}>
	<h1>{term.label}</h1>
	<p>{posts.length} {posts.length === 1 ? "post" : "posts"}</p>

	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={`/posts/${post.id}`}>
						{post.data.featured_image && <Image image={post.data.featured_image} />}
						<h2>{post.data.title}</h2>
					</a>
					{post.data.excerpt && <p>{post.data.excerpt}</p>}
				</li>
			))
		}
	</ul>
</Base>
