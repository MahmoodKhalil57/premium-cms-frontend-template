---
import Base from "../../layouts/Base.astro";
import { getEmDashCollection } from "../../lib/emdash";
import CmsContent from "../../components/CmsContent.astro";

export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("pages");
	// `home` is the homepage body, rendered at `/` — not as a standalone page.
	return entries.filter((entry) => entry.id !== "home").map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const page = Astro.props.entry ?? (await getEmDashCollection("pages")).entries.find((e) => e.id === Astro.params.slug && e.id !== "home");
if (!page) return Astro.redirect("/404");
---

<Base title={page.data.title ?? page.id} content={{ collection: "pages", id: page.data.id, slug: page.id }}>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title">{page.data.title}</h1>
		</header>
		<div class="page-content">
			<CmsContent value={page.data.content} collection="pages" entryId={page.data.id} slug={page.id} />
		</div>
	</article>
</Base>
