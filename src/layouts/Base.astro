---
import { getEmDashCollection, getMenu, getSiteSettings } from "../lib/emdash";
import { getLayout, renderLayoutSection, fillLayoutSlots } from "../lib/layout";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { CMS_URL } from "../config";
import { cmsFragments } from "../lib/cms";
import "../styles/site.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	type?: "website" | "article";
	/** Content reference, so the platform\'s editing tools know what the page shows. */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, type = "website", content } = Astro.props;
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");
const socialMenu = await getMenu("social");
const { entries: footerPages } = await getEmDashCollection("pages");
const year = new Date().getFullYear();

// Designer-owned chrome: the `site-header` / `site-footer` SECTIONS
// (Manage → Sections) render instead of the built-in header/footer when
// they exist — page-builder blocks whose [data-menu] / [data-widget-area] /
// [data-site-title] / [data-theme-switcher] markers are filled from the
// CMS at build time.
const layout = await getLayout();
const site = { title: siteTitle, tagline: siteTagline };
const headerHtml = renderLayoutSection(layout, "site-header", site);
const footerHtml = renderLayoutSection(layout, "site-footer", site);

// Built-in footer shows the `sidebar` widget area (Manage → Widgets).
const footerWidgets = fillLayoutSlots('<div data-widget-area="sidebar"></div>', layout, site);
// Platform contributions (empty on GitHub Pages; SEO/toolbar/plugins when PremiumCMS hosts the site).
const cms = await cmsFragments(Astro, { title: fullTitle, description: pageDescription, image, canonical, type, content });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={pageTitle ?? title} />
		{pageDescription && <meta property="og:description" content={pageDescription} />}
		{image && <meta property="og:image" content={image} />}
		{/* Color scheme applied in the CMS (Admin → Color schemes): tokens + base layer, served live. */}
		<link rel="stylesheet" href={`${CMS_URL}/frontend-api/theme.css`} />
		<Fragment set:html={cms.head} />
		<script is:inline>
			// Apply an explicit theme choice immediately (shared cookie with the
			// CMS-rendered pages); harmless when the design has no theming.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<Fragment set:html={cms.bodyStart} />
		{headerHtml ? <div class="layout-slot" set:html={headerHtml} /> : (
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-title">{siteTitle}</a>
				<div class="nav-right">
					<form class="site-search-form" action="/search" method="get" role="search">
						<input type="search" name="q" placeholder="Search..." aria-label="Search" />
					</form>
					<div class="nav-links">
						{menu?.items.map((item) => (
							<a href={item.url} target={item.target}>{item.label}</a>
						))}
					</div>
				</div>
			</nav>
		</header>
		)}

		<main>
			<slot />
		</main>

		{footerHtml ? <div class="layout-slot" set:html={footerHtml} /> : (
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo">{siteTitle}</a>
						<p class="footer-tagline">{siteTagline}</p>
					</div>
					<div class="footer-nav">
						<h4 class="footer-heading">Navigate</h4>
						<ul class="footer-links">
							<li><a href="/">Home</a></li>
							<li><a href="/posts">All Posts</a></li>
							{footerPages.filter((p) => p.id !== "home").slice(0, 3).map((page) => (
								<li><a href={`/pages/${page.id}`}>{page.data.title}</a></li>
							))}
						</ul>
					</div>
					<div class="footer-nav">
						<h4 class="footer-heading">Connect</h4>
						<ul class="footer-links">
							{socialMenu?.items.map((item) => (
								<li>
									<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.label}</a>
								</li>
							))}
							<li><a href="/rss.xml">RSS Feed</a></li>
						</ul>
					</div>
					<div class="footer-widgets-section">
						<Fragment set:html={footerWidgets} />
					</div>
				</div>
				<div class="footer-bottom">
					<p class="footer-copyright">© {year} {siteTitle} · Powered by <a href="https://premium-cms.com">PremiumCMS</a></p>
					<div class="theme-switcher">
						<button type="button" class="theme-btn" data-theme="light" aria-label="Light mode">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
						</button>
						<button type="button" class="theme-btn" data-theme="dark" aria-label="Dark mode">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
						</button>
						<button type="button" class="theme-btn" data-theme="system" aria-label="System theme">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
						</button>
					</div>
				</div>
			</div>
		</footer>
		)}

		<script>
			import "../scripts/forms";
			import "../scripts/shop";
		</script>

		<script>
			// Theme switcher buttons (present when a designed section includes a
			// [data-theme-switcher] marker); shares the `theme` cookie with the CMS.
			const themeBtns = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			if (themeBtns.length > 0) {
				const root = document.documentElement;
				const setCookie = (value: string) => {
					const secure = location.protocol === "https:" ? "; Secure" : "";
					document.cookie =
						value === ""
							? `theme=; path=/; max-age=0; SameSite=Lax${secure}`
							: `theme=${value}; path=/; max-age=31536000; SameSite=Lax${secure}`;
				};
				const setTheme = (theme: string) => {
					if (theme === "system") {
						setCookie("");
						root.classList.remove("light", "dark");
					} else {
						setCookie(theme);
						root.classList.remove("light", "dark");
						root.classList.add(theme);
					}
					themeBtns.forEach((btn) => btn.classList.toggle("active", btn.dataset.theme === theme));
				};
				const match = document.cookie.match(/theme=([^;]+)/);
				setTheme(match?.[1] ?? "system");
				themeBtns.forEach((btn) => {
					btn.addEventListener("click", () => setTheme(btn.dataset.theme || "system"));
				});
			}
		</script>

		<Fragment set:html={cms.bodyEnd} />

		<style is:global>
			/* Forms (premium-forms plugin) — minimal, inherits the site's type/colours. */
			.ec-form { display: grid; gap: 1rem; max-width: 40rem; }
			.ec-form-page { border: 0; padding: 0; margin: 0; display: grid; gap: 1rem; }
			.ec-form-field { display: grid; gap: 0.35rem; }
			.ec-form-label { font-weight: 600; }
			.ec-form-input, .ec-form-page select { font: inherit; padding: 0.6rem 0.75rem; border: 1px solid currentColor; border-radius: 4px; background: transparent; color: inherit; width: 100%; }
			.ec-form-radio-group, .ec-form-checkbox-group { border: 0; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
			.ec-form-help { font-size: 0.875rem; opacity: 0.75; }
			.ec-form-error { color: #b42318; font-size: 0.875rem; min-height: 1em; }
			.ec-form-required { color: #b42318; }
			.ec-form-submit { font: inherit; padding: 0.65rem 1.25rem; border-radius: 4px; border: 1px solid currentColor; background: transparent; color: inherit; cursor: pointer; }
			.ec-form-submit[disabled] { opacity: 0.6; cursor: default; }
			.ec-form-status--success { color: #067647; }
			.ec-form-status--error { color: #b42318; }
			/* Shop (premium-commerce plugin) — minimal, inherits the site's type/colours. */
			.ec-shop__header, .ec-add-to-cart-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
			.ec-product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
			.ec-product-card { display: flex; flex-direction: column; gap: 0.5rem; }
			.ec-product-card__media img, .ec-product__media img { width: 100%; height: auto; display: block; border-radius: 6px; }
			.ec-product-card__placeholder { aspect-ratio: 1; border-radius: 6px; background: color-mix(in srgb, currentColor 8%, transparent); }
			.ec-product-card__title { margin: 0; font-size: 1rem; }
			.ec-product-card__price, .ec-product__price { display: flex; gap: 0.5rem; align-items: baseline; margin: 0; font-weight: 600; }
			.ec-product-card__price s, .ec-product__price s { opacity: 0.6; font-weight: 400; }
			.ec-product-card__stock { margin: 0; font-size: 0.8rem; opacity: 0.8; }
			.ec-add-to-cart, .ec-form-submit--secondary { font: inherit; padding: 0.6rem 1rem; border-radius: 4px; border: 1px solid currentColor; background: transparent; color: inherit; cursor: pointer; }
			.ec-add-to-cart[disabled] { opacity: 0.5; cursor: default; }
			.ec-add-to-cart--error { border-color: #b42318; color: #b42318; }
			.ec-qty { display: inline-flex; align-items: center; gap: 0.4rem; }
			.ec-qty input { width: 4rem; font: inherit; padding: 0.5rem; border: 1px solid currentColor; border-radius: 4px; background: transparent; color: inherit; }
			.ec-product__layout { display: grid; gap: 2rem; grid-template-columns: 1fr; }
			@media (min-width: 48rem) { .ec-product__layout { grid-template-columns: 1fr 1fr; } }
			.ec-product__sku, .ec-breadcrumb { font-size: 0.85rem; opacity: 0.7; }
			.ec-cart__table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
			.ec-cart__table th, .ec-cart__table td { text-align: start; padding: 0.5rem 0.25rem; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); }
			.ec-cart__table input { width: 4rem; font: inherit; padding: 0.35rem; }
			.ec-link { background: none; border: 0; padding: 0; color: inherit; text-decoration: underline; cursor: pointer; font: inherit; }
			.ec-checkout { display: grid; gap: 1rem; max-width: 30rem; margin-top: 1.5rem; }
			.ec-checkout__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
			.ec-cart__note, .ec-order__meta { opacity: 0.8; }
			/* Layout sections render through wrappers; make them transparent to
			   the page layout so position:sticky inside them works. */
			.layout-slot,
			.layout-slot .grapes-block {
				display: contents;
			}
		</style>
	</body>
</html>
